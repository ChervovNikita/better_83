# SN83 production environment. Sourced by every deploy/ script.
#
# THE VALUES BELOW ARE SPECIFIC TO ONE BOX. On a new server you MUST update:
#   REPO / CUDA_HOME       paths
#   SN83_GPU_ARCH          your GPU's compute capability (86 = RTX A4000)
#   SN83_CPU_BUDGET        cores available for the worker split (20 here)
#   WALLET_NAME / _HOTKEY  your wallet
#   AXON_IP                the INGRESS address (on Vast: $PUBLIC_IPADDR)
#   AXON_PORT              an internal port that is actually forwarded
#   AXON_EXTERNAL_PORT     the external number it maps to
# See SETUP.md, sections 4 and 5. Publishing the wrong ip/port is silently
# fatal: the chain says is_serving=True and every round scores zero.
#
# Read once before changing anything: THREAD COUNT CHANGES THE ANSWER HERE, not
# just the speed. The solver was tuned at 8 threads and the numbers in
# research_manual/ were measured there.

REPO=/home/dev/better_83
VENV="$REPO/.venv"
PY="$VENV/bin/python"

# ---------------------------------------------------------------- CUDA
# No root on this box, so the toolkit is the NVIDIA apt debs unpacked into
# ~/opt. nvcc is needed at RUNTIME, not just at build time: gpu_lib rebuilds
# libcliquegpu_l32.so whenever clique_gpu.cu is newer than the .so.
export CUDA_HOME=/opt/cuda
export SN83_NVCC="$CUDA_HOME/bin/nvcc"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# RTX A4000 is sm_86, which is also gpu_lib's default.
export SN83_GPU_ARCH=86

# ------------------------------------------------------------- dispatcher
export SN83_BACKEND=gpu
export SN83_WORKERS=4          # one process per device; two contexts on one
                               # card time-slice it and BOTH answers then miss
                               # the deadline. Acquire order is gpu0, gpu1,
                               # gpu2, gpu3, then the CPU overflow worker.
export SN83_CPU_WORKERS=1      # last resort, no device. Reached only when all
                               # four GPUs are busy (five-deep concurrency),
                               # which has never been observed.

# 20 cores here (nproc / sched_getaffinity), no CFS cap. Four GPU workers
# cannot each get the tuned 8 without overlapping pins, so overflow is
# reserved at 1 -- it is last resort, five-deep, never observed -- and the
# GPUs split the rest. The even cut is 4 each; the leftover 3 go +2 to
# gpu0 and +1 to gpu1 (81% of rounds are one-deep, 19% two-deep):
# 6+5+4+4+1 = 20, disjoint. Raising overflow back to 8 would drop every
# GPU worker to 3 threads on 100% of rounds to serve a path that does not run.
export SN83_CPU_BUDGET=20
export SN83_OVERFLOW_THREADS=1

export SN83_SOLVE_K=8192       # cliques kept per level (omega and omega-1). Every
                               # simulate.py number used 8192; a rich round holds
                               # ~2,600 omega-cliques, so 64 threw diversity away.

# Our fleet size is COUNTED, not configured: every hotkey registered on netuid 83
# under one of the coldkeys listed in SN83_COLDKEYS_FILE, read from the
# metagraph snapshot refresh_metagraph.sh keeps fresh. Registering (or losing)
# a hotkey changes it at the next refresh with no edit here. List every coldkey
# you mine under, one ss58 per line. Check it: deploy/fleet_size.sh
# An integer instead of "auto" pins the count (only for tests / simulation).
export SN83_COLDKEYS_FILE="$REPO/deploy/coldkeys.txt"
export SN83_FLEET_N=auto

# Fleet size at/above which the maximin picker replaces the derived one. It
# runs on what the 2 s budget has left after the harvest and falls back to the
# derived board when that is not enough; /health reports minimax_stats.
export SN83_MINIMAX_N=150
export SN83_PICK_THREADS=4

export SN83_DISPATCH_URL=http://127.0.0.1:8899
export SN83_DISPATCH_HOST=127.0.0.1
export SN83_DISPATCH_PORT=8899

# ------------------------------------------------------------------ miner
export NETUID=83
export SUBTENSOR_NETWORK=finney
export WALLET_NAME=83_entity
export WALLET_HOTKEY=83_miner1
# This is a Vast.ai container behind NAT. Only a fixed set of internal ports is
# forwarded, each under a DIFFERENT external number -- `env | grep VAST_TCP_PORT_`
# prints the map. So the axon BINDS an internal port that is mapped and
# PUBLISHES the external one:
#
#     internal 8000  ->  external 20064      (VAST_TCP_PORT_8000)
#
# Nothing mapped 8091, which is why 28 rounds scored zero with an empty answer:
# the validator's request never reached the process.
# This box forwards internal 10-250 (241 ports), each to a different external
# number -- `env | grep VAST_TCP_PORT_` prints the map. RESERVED, never give
# these to a miner: 22 (ssh) and 80 (taken on this host). The fleet launcher
# uses 100-249, which is 150 contiguous ports clear of both.
export AXON_PORT=100
export AXON_EXTERNAL_PORT=15843

# The INGRESS address, from Vast's own PUBLIC_IPADDR. NOT what api.ipify.org
# reports -- that is the EGRESS address (174.136.205.7), which refuses inbound
# connections. Publishing the egress address is silently fatal: the axon looks
# served on chain and nothing can reach it.
export AXON_IP=76.27.73.50

# ------------------------------------------------------------------- pm2
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null
